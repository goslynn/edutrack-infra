# Clave pública RS256 del Auth Service para validación JWT.
# Obtenerla desde: cat <ruta-auth-service>/src/main/resources/publicKey.pem
# En producción se gestiona vía K8s Secret (ver k8s/kongplugins.yaml).
KONG_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"
