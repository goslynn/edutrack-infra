# ─── Repositorio del Auth Service ───────────────────────────────────────────
# Ruta al repo edutrack-ms-auth clonado localmente (debe ser hermano de este repo
# salvo que lo ajustes aquí).
AUTH_SERVICE_PATH=../edutrack-ms-auth

# ─── Base de Datos (Auth Service) ───────────────────────────────────────────
DB_NAME=edutrack
DB_USER=auth_user
DB_PASSWORD=auth_pass

# ─── RabbitMQ ───────────────────────────────────────────────────────────────
RABBITMQ_USER=edutrack
RABBITMQ_PASS=edutrack_pass

# ─── Admin inicial del Auth Service ─────────────────────────────────────────
# Sobreescribir en producción via K8s Secret
AUTH_SEED_ADMIN_EMAIL=admin@edutrack.cl
AUTH_SEED_ADMIN_PASSWORD=changeme123!
AUTH_SEED_ADMIN_DISPLAY_NAME=Administrador
