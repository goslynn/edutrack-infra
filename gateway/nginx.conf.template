worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

# nginx borra env vars por defecto — declararlas explícitamente para que os.getenv() funcione en Lua
env JWT_PUBLIC_KEY;
env UPSTREAM_HOST_PATTERN;
env JWKS_SERVICE;

events {
    worker_connections 1024;
}

http {
    # DNS resolver extraído de /etc/resolv.conf en el entrypoint
    resolver ${RESOLVER} valid=10s ipv6=off;

    # Path de los módulos Lua del gateway
    lua_package_path '/etc/nginx/lua/?.lua;;';

    # Rate limiting: 200 req/min por IP
    limit_req_zone $binary_remote_addr zone=api:10m rate=200r/m;
    limit_req_status 429;

    # Correlation ID: respeta el header entrante o genera uno desde el request_id de nginx
    map $http_x_correlation_id $correlation_id {
        ""      $request_id;
        default $http_x_correlation_id;
    }

    # CORS: refleja el Origin SOLO si coincide con el permitido (${CORS_ALLOW_ORIGIN},
    #   inyectado por envsubst; default http://localhost:5173). Para cualquier otro
    #   origen la variable queda vacía y `add_header` con valor vacío se omite ⇒ el
    #   navegador bloquea. Echo del origen (no `*`) por si en el futuro se usan cookies.
    map $http_origin $cors_allow_origin {
        default                   "";
        "${CORS_ALLOW_ORIGIN}"    "${CORS_ALLOW_ORIGIN}";
    }

    server {
        listen 8080;
        server_tokens off;

        # ── CORS (el gateway es el único punto de entrada; la SPA corre en otro
        #    origen, así que ES ACÁ donde se responden los headers — `server.cors`
        #    de Vite solo cubre el dev-server, no este backend). Los add_header son
        #    a nivel server ⇒ se heredan en todas las locations (ninguna define
        #    add_header propio, por lo que la herencia no se rompe). ─────────────
        add_header Access-Control-Allow-Origin  $cors_allow_origin                          always;
        add_header Access-Control-Allow-Methods  "GET, POST, PUT, PATCH, DELETE, OPTIONS"    always;
        add_header Access-Control-Allow-Headers  "Authorization, Content-Type, X-Correlation-ID" always;
        add_header Access-Control-Max-Age        86400                                       always;
        add_header Vary                          "Origin"                                    always;

        # Preflight: el `if` a nivel server corre en la fase rewrite, ANTES de
        #   seleccionar location ⇒ corta el OPTIONS antes de Lua/upstream y sin
        #   consumir rate-limit, respondiendo 204 con los headers CORS de arriba.
        if ($request_method = OPTIONS) {
            return 204;
        }

        # Headers que viajan a todos los upstreams
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_set_header X-Correlation-ID $correlation_id;

        # Header de vuelta al cliente
        add_header X-Correlation-ID $correlation_id always;

        # ── Rutas públicas — sin JWT ──────────────────────────────────────

        location ~ ^/[^/]+/login$ {
            limit_req zone=api burst=20 nodelay;
            set $upstream_host "";
            access_by_lua_file /etc/nginx/lua/upstream.lua;
            proxy_pass http://$upstream_host;
        }

        location ~ ^/[^/]+/refresh$ {
            limit_req zone=api burst=20 nodelay;
            set $upstream_host "";
            access_by_lua_file /etc/nginx/lua/upstream.lua;
            proxy_pass http://$upstream_host;
        }

        # JWKS — público. Llega como /<servicio>/.well-known/... porque cada MS
        # declara su serviceId como basePath (@ApplicationPath("/auth")); el
        # primer segmento es además la clave de enrutamiento del gateway.
        location ~ ^/[^/]+/\.well-known/ {
            limit_req zone=api burst=10 nodelay;
            set $upstream_host "";
            access_by_lua_file /etc/nginx/lua/upstream.lua;
            proxy_pass http://$upstream_host;
        }

        # Metadatos de auto-descripción del servicio — públicos. Namespace
        # reservado /<servicio>/meta/... donde cada MS publica metadatos suyos
        # (no datos de dominio): hoy GET /<servicio>/meta/resources con el
        # catálogo de resource keys asignables. Público para que el frontend/BFF
        # pueda barrer todos los servicios y poblar la UI de permisos sin token.
        location ~ ^/[^/]+/meta/ {
            limit_req zone=api burst=20 nodelay;
            set $upstream_host "";
            access_by_lua_file /etc/nginx/lua/upstream.lua;
            proxy_pass http://$upstream_host;
        }

        # ── Rutas protegidas — JWT requerido ─────────────────────────────

        location ~ ^/ {
            limit_req zone=api burst=50 nodelay;
            set $upstream_host "";
            access_by_lua_file /etc/nginx/lua/jwt.lua;
            proxy_pass http://$upstream_host;
        }
    }
}
