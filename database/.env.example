# Base de datos compartida — variables de entorno (dev local)
#
# Copia este archivo a `infra/database/.env` y ajusta lo que necesites; `.env`
# está gitignored. Todos los valores tienen un default de dev en el compose, así
# que el .env es opcional. Mantén estas credenciales en sintonía con el `.env`
# de cada microservicio (DB_USER / DB_PASSWORD / DB_NAME / DB_PORT) — comparten
# la misma instancia.

# Imagen del motor
POSTGRES_IMAGE=postgres:16-alpine

# Credenciales del superusuario y nombre de la base ÚNICA compartida
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=edutrack_local

# Puerto publicado al host (host:contenedor → ${DB_PORT}:5432)
DB_PORT=5432

# Identidad del contenedor en la red `edutrack` (alcanzable también como
#   `postgres` y `database` vía network aliases)
DB_CONTAINER_NAME=postgres

# Nombre del volumen persistente (estable, independiente del nombre del proyecto)
DB_VOLUME=edutrack_pgdata

# Red externa creada por el compose de infra (../docker-compose.yml)
EDUTRACK_NETWORK=edutrack
